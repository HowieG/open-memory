{
  "name": "@open-memory/app",
  "private": true,
  "version": "0.0.1",
  "description": "Minimal Electron shell — drop an export .zip, see your conversations. M1.",
  "main": "main.js",
  "scripts": {
    "build-core": "esbuild ../core/src/index.ts --bundle --platform=node --format=cjs --outfile=core.cjs",
    "build-renderer": "vite build",
    "build": "npm run build-core && npm run build-renderer",
    "start": "npm run build && electron .",
    "smoke": "npm run build-core && node smoke.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "0.10.50",
    "@assistant-ui/react-markdown": "0.10.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
